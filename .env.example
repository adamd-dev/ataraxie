# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# AI import of exam PDFs. Set at least one key; leave both empty to disable AI import.
# AI_PROVIDER picks one when both keys are set (meta | claude). Default: meta if its key is set.
AI_PROVIDER=
# console.anthropic.com → API Keys. Secret: server only.
ANTHROPIC_API_KEY=
# dev.meta.ai → API keys. Secret: server only.
META_API_KEY=
# Optional, default muse-spark-1.3. Never a "-contributor" model: Meta may train on what it receives.
META_MODEL=
